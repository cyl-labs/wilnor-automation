    {
      "id": "cg03-pick-row",
      "name": "Pick Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const targetRow = Number($('Webhook').item.json.body.row);\nif (!targetRow || isNaN(targetRow)) throw new Error('No row number provided. POST body must include { \"row\": N }');\nconst allRows = $input.all().map((i, idx) => ({ ...i.json, _idx: idx }));\nconst match = allRows.find((r, idx) => (idx + 2) === targetRow);\nif (!match) throw new Error('Row ' + targetRow + ' not found in sheet.');\nconst { _idx, ...rest } = match;\nreturn [{ json: { ...rest, ROW_NUMBER: targetRow } }];\n"
      }
    },
    {
      "id": "cg04-build",
      "name": "Build Replacements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\n\nfunction getVal(row, key) {\n  if (row[key] !== undefined) return String(row[key] || '').trim();\n  const found = Object.keys(row).find(k => k.trim() === key);\n  return found ? String(row[found] || '').trim() : '';\n}\n\nconst employerName = getVal(row, 'Employer Name');\nconst maidName = getVal(row, 'Maid Name');\nconst label = employerName + ' — ' + maidName;\n\nconst pairs = [\n  ['{{DATE}}',         getVal(row, 'Starting Date')],\n  ['{{EMPLOYERNAME}}', employerName],\n  ['{{NRIC}}',         getVal(row, 'NRIC')],\n  ['{{ADDRESS}}',      getVal(row, 'Address')],\n  ['{{AGENCYFEE}}',    getVal(row, 'Agency Fee')],\n  ['{{LOAN}}',         getVal(row, 'Loan')],\n  ['{{SERVICE}}',      '12'],\n  ['{{MAIDNAME}}',     maidName],\n  ['{{BASIC}}',        getVal(row, 'Basic salary')],\n  ['{{OFF}}',          getVal(row, 'Off')],\n  ['{{SALARY}}',       getVal(row, 'Total salary')],\n  ['{{PASSPORT}}',     getVal(row, 'Passport') || getVal(row, 'Passport ')],\n  ['{{PHONE}}',        getVal(row, 'Phone')],\n  ['{{WP}}',           getVal(row, 'WP')],\n  ['{{SALARYDATE}}',   getVal(row, 'Salary payment day')],\n  ['{{COMPENSATION}}', getVal(row, 'Compensation')],\n  ['{{REPATRIATION}}', getVal(row, 'Repatriation destination')],\n  ['{{COUNTRY}}',      getVal(row, 'Country')],\n];\n\nconst batchRequests = pairs.map(([find, replace]) => ({\n  replaceAllText: {\n    containsText: { text: find, matchCase: true },\n    replaceText: replace,\n  }\n}));\n\nreturn {\n  json: {\n    TIMESTAMP:       getVal(row, 'Timestamp'),\n    ROW_NUMBER:      row.ROW_NUMBER,\n    EMPLOYER_NAME:   employerName,\n    MAID_NAME:       maidName,\n    EMAIL:           getVal(row, 'Email'),\n    BATCH_REQUESTS:  batchRequests,\n    SA_NAME:         'Service Agreement — ' + label,\n    SAFETY_NAME:     'Safety Agreement — ' + label,\n    EC_NAME:         'Employment Contract — ' + label,\n    FOLDER_ID:       '1exoPi9K0SInFjzf7U16w_cbsttY3zJpw',\n    SA_TEMPLATE:     '1XKvdaUJIjAVKr_ZlAqVokLNJLZzZ23w2w4dBc5cZjvM',\n    SAFETY_TEMPLATE: '1fBnLlN3r2oWUZk4FHeQHWEHKhzm2w8wSpx8foA5aZ2M',\n    EC_TEMPLATE:     '19RNlwnaPo3IGMh2mXNk5K97o1MCJ-lG8cCXLrRODMn4',\n  }\n};\n"
      }
    },
