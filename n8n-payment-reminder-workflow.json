{
  "name": "Salary Payment Reminder",
  "nodes": [
    {
      "id": "pr01-schedule",
      "name": "Every Day 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "pr02-read-sheet",
      "name": "Read Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "150FbUAyIg_Lid4WiBn-Fk8jZk55oc0b5cyfIbpogxfw", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Form Responses 1", "mode": "name" },
        "options": {},
        "authentication": "serviceAccount"
      },
      "credentials": { "googleApi": { "id": "hJIK4knNVdFbbeYJ", "name": "Wilnor Sheets API" } }
    },
    {
      "id": "pr03-check",
      "name": "Find Due Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const todayDay = new Date().getDate();\n\nfunction getVal(row, key) {\n  if (row[key] !== undefined) return String(row[key] || '').trim();\n  const found = Object.keys(row).find(k => k.trim() === key);\n  return found ? String(row[found] || '').trim() : '';\n}\n\nconst rows = $input.all().map(i => i.json);\n\nconst due = rows.filter(row => {\n  const payDay = parseInt(getVal(row, 'Salary payment day'));\n  if (isNaN(payDay)) return false;\n  return payDay === todayDay;\n});\n\nconst today = new Date().toLocaleDateString('en-SG', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Singapore' });\n\nreturn [{ json: {\n  hasDue: due.length > 0,\n  count: due.length,\n  today,\n  todayDay,\n  items: due.map(r => ({\n    employer: getVal(r, 'Employer Name'),\n    maid: getVal(r, 'Maid Name'),\n    salary: getVal(r, 'Total salary'),\n    payDay: getVal(r, 'Salary payment day')\n  }))\n} }];\n"
      }
    },
    {
      "id": "pr04-if",
      "name": "Has Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "check-has-due",
              "leftValue": "={{ $json.hasDue }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "pr05-email",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1120, 200],
      "parameters": {
        "sendTo": "cyllabsdigital@gmail.com",
        "subject": "=💰 Salary Due Today ({{ $json.today }}) — {{ $json.count }} employer(s)",
        "emailType": "html",
        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;\">' + '<h2 style=\"color:#222;\">💰 Salary Payment Due Today</h2>' + '<p>The following employers are due to pay salary today, <strong>' + $json.today + '</strong>:</p>' + '<table style=\"width:100%;border-collapse:collapse;margin-top:16px;\">' + '<tr style=\"background:#f3f4f6;\"><th style=\"padding:10px;text-align:left;border:1px solid #e5e7eb;\">Employer</th><th style=\"padding:10px;text-align:left;border:1px solid #e5e7eb;\">Helper</th><th style=\"padding:10px;text-align:right;border:1px solid #e5e7eb;\">Salary</th></tr>' + $json.items.map(i => '<tr><td style=\"padding:10px;border:1px solid #e5e7eb;\">' + i.employer + '</td><td style=\"padding:10px;border:1px solid #e5e7eb;\">' + i.maid + '</td><td style=\"padding:10px;text-align:right;border:1px solid #e5e7eb;\">$' + i.salary + '</td></tr>').join('') + '</table>' + '</div>' }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CREDENTIAL_ID",
          "name": "Gmail Account"
        }
      }
    }
  ],
  "connections": {
    "Every Day 8am": { "main": [[{ "node": "Read Sheet",    "type": "main", "index": 0 }]] },
    "Read Sheet":    { "main": [[{ "node": "Find Due Today","type": "main", "index": 0 }]] },
    "Find Due Today":{ "main": [[{ "node": "Has Due?",      "type": "main", "index": 0 }]] },
    "Has Due?":      { "main": [[{ "node": "Send Reminder", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Singapore" },
  "active": false
}
